{
  "name": "@uzukko/agentpm",
  "version": "0.5.1",
  "description": "AgentPM CLI - operate AgentPM tasks, wiki and files from your terminal or an AI agent (Claude Code etc.)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentpm": "./bin/taskapp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://agentpm.app",
  "keywords": [
    "agentpm",
    "task-management",
    "cli",
    "claude-code",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
